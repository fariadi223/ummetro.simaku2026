APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Database akademik (PostgreSQL) untuk referensi prodi
AKADEMIK_DB_HOST=127.0.0.1
AKADEMIK_DB_PORT=5432
AKADEMIK_DB_DATABASE=ummetro_pdptumm
AKADEMIK_DB_USERNAME=postgres
AKADEMIK_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120


# Docker: REDIS_HOST=redis (service di docker-compose.yml), DB 0/1/2.
# Host bersama (Redis dipakai aplikasi lain): pakai nomor DB tersendiri,
# karena `cache:clear` mem-FLUSHDB seluruh REDIS_CACHE_DB.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=simaku_v2_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SIMPRODI_URL=http://simprodi.ummetro.ac.id
SIMPRODI_ENDPOINT=/apiclient/synctracer
SIMPRODI_SECRET=

# Neo Feeder (web service PDDikti) -- sumber data mahasiswa lulus
NEOFEEDER_URL=https://neofeeder.ummetro.ac.id:3003/ws/live2.php
NEOFEEDER_USERNAME=
NEOFEEDER_PASSWORD=
NEOFEEDER_ACT_LULUS=ExportDataMahasiswaLulus
NEOFEEDER_TIMEOUT=180
NEOFEEDER_PER_HALAMAN=500

# Paksa kegiatan unit selalu bisa diubah (v1: UPDATE_FORCE_KEGIATAN)
UPDATE_FORCE_KEGIATAN=false
